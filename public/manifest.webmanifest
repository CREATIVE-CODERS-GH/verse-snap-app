{
  "name": "Verse Snap",
  "short_name": "Verse Snap",
  "description": "A quiet, fast way to open and read any Bible verse.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
