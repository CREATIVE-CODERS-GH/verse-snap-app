# Verse Snap environment variables — names and safe placeholders only.
# Copy to .env.local for local development. On Vercel, add them under
# Project Settings → Environment Variables. Never commit real values.

# --- Supabase (independent project) -----------------------------------------
# Browser: baked into the client bundle at BUILD time. The publishable key is
# public by design; Row Level Security protects the data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Server (SSR, server functions, auth middleware): read at RUN time.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# SECRET — server only. Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# --- Optional AI search (OFF by default; paid API) ---------------------------
# Leave AI_SEARCH_ENABLED=false for testing deployments. When false, no
# OpenAI request is made and OPENAI_API_KEY may be left unset.
AI_SEARCH_ENABLED=false
# SECRET — server only. Leave empty unless AI search is deliberately enabled.
OPENAI_API_KEY=
# SECRET — server only. Random string used to hash rate-limit identities.
RATE_LIMIT_SALT=replace-with-a-long-random-string

# --- Free Bible keyword search (no AI, no cost) ------------------------------
# OFF by default: the search screen then says "Free Bible search is being prepared."
# Turn on only after the search migrations and the Bible import have been approved
# and applied. Needs SUPABASE_SERVICE_ROLE_KEY and RATE_LIMIT_SALT above.
FREE_SEARCH_ENABLED=false
# Optional tuning (defaults shown): per-person limits, one shared per-minute ceiling,
# and the hard time limit for one search in milliseconds (500-5000).
# FREE_LIMIT_GUEST_MINUTE=30
# FREE_LIMIT_GUEST_DAY=600
# FREE_LIMIT_USER_MINUTE=60
# FREE_LIMIT_USER_DAY=1500
# FREE_LIMIT_GLOBAL_MINUTE=300
# FREE_SEARCH_TIMEOUT_MS=2000
